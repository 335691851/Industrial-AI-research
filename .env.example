# Optional locally: without Supabase the app uses .data/ (not supported on Vercel).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase connection URL for LangGraph Postgres checkpoints.
# Use Shared Pooler session mode (port 5432), database /postgres, SSL required.
# URL-encode special characters in the database password.
DATABASE_URL=
# 64 hex characters (32 bytes), required for API key encryption.
CREDENTIAL_ENCRYPTION_KEY=
CRON_SECRET=
# No login UI: trust your internal reverse proxy / Vercel protection.
# Production mutations require a matching header, injected by your trusted proxy.
WORKSPACE_ACCESS_TOKEN=
# Optional discovery, improves keyword/company coverage beyond configured sites.
TAVILY_API_KEY=
